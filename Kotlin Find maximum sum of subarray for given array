fun MaxSumOfSubArray(arr : IntArray, input:Int) {
 
    println("Arrays -- ${arr.joinToString(",")}")
    var current_sum=0
    var max_sum =0
    
    for(i in 0 until arr.size){
        current_sum = current_sum + arr[i]
        
        if(max_sum<current_sum){
            max_sum = current_sum
        }
        if(current_sum<0){
            current_sum =0
        }
     }
    println("max sumarry $max_sum")
}
