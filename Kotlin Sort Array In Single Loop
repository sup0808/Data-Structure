fun main() {
	sortArrayInSingleLoop()
}

fun sortArrayInSingleLoop(){
    val arr = intArrayOf(1,5,2,0,4,3,9,7)
    var i=0
    var j=i+1
    while(i<arr.size && j<arr.size){
        var temp = 0
        if(arr[i]>arr[j]){
            temp = arr[i]
            arr[i] = arr[j]
            arr[j] = temp
            i = 0
            j= i+1
        }
        else{
            i++
            j++
        }
    }
  
    println("Sorted array :: ${arr.joinToString(",")}")
}
