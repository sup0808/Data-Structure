fun main() {
    val arr :IntArray = intArrayOf(2,3,10,6,4,8)
	
    println("Element out at index ${bubbleSort(arr)}")
}


fun bubbleSort(arr : IntArray){
    
    for(i in 0 until arr.size){
        for(j in 0 until arr.size-1){
            if(arr[j]>arr[j+1]){
                var temp = arr[j]
                arr[j] = arr[j+1]
                arr[j+1] = temp
            }
        }
    }
    
    println("Sorted ${arr.joinToString(",")}")
}
